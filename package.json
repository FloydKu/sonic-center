{
  "name": "sonic-center",
  "version": "0.1.0",
  "description": "Sonic Center - Electron + React 本地音乐管理中心 (VS Code 风格 UI)",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:renderer\"",
    "dev:main": "tsc -p tsconfig.node.json && electron .",
    "dev:renderer": "vite",
    "build": "tsc -p tsconfig.node.json && vite build",
    "dist": "npm run build && electron-builder --win portable",
    "build:mtp": "powershell -NoProfile -ExecutionPolicy Bypass -File build-mtp.ps1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "better-sqlite3": "^11.10.0",
    "music-metadata": "^10.5.0",
    "node-id3": "^0.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.0",
    "electron": "^32.1.0",
    "electron-builder": "^25.0.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.6"
  }
}
